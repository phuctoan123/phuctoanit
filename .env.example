# ═══════════════════════════════════════════════════════════════════════════════
# Environment Variables Example for Supabase Integration
# Website: phuctoanit.id.vn
# ═══════════════════════════════════════════════════════════════════════════════

# Your Supabase Project URL (found in Project Settings > API > Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon/Public Key (found in Project Settings > API > Project API keys > anon/public)
# Safe to expose in client-side code because Row Level Security (RLS) protects the database
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ── Vercel Deployment Instructions ──────────────────────────────────────────
# 1. Go to your Vercel Project Dashboard: Settings > Environment Variables
# 2. Add:
#    - Key: SUPABASE_URL       Value: https://your-project-id.supabase.co
#    - Key: SUPABASE_ANON_KEY  Value: your-anon-key-here
# 3. For a static HTML/JS site, you can configure these directly in js/site-stats.js
#    or inject them via window.__ENV__ before loading js/site-stats.js.
